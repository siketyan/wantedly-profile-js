{
  "name": "wantedly-profile",
  "version": "0.0.0",
  "description": "Easy and strongly-typed Wantedly profiles fetcher.",
  "author": "Naoki Ikeguchi <me@s6n.jp>",
  "license": "MIT",
  "homepage": "https://github.com/siketyan/wantedly-profile-js#readme",
  "bugs": {
    "url": "https://github.com/siketyan/wantedly-profile-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siketyan/wantedly-profile-js.git"
  },
  "main": "./cjs/index.js",
  "module": "./esm/index.js",
  "types": "./esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./esm/index.d.ts",
      "import": "./esm/index.js",
      "import-sync": "./esm/index.js",
      "require": "./cjs/index.js"
    }
  },
  "files": [
    "cjs",
    "esm"
  ],
  "scripts": {
    "lint": "biome check",
    "fix": "biome check --write",
    "build": "run-s build:esm build:cjs",
    "build:esm": "tsc -p ./tsconfig.esm.json",
    "build:cjs": "tsc -p ./tsconfig.cjs.json",
    "test": "ts-node ./tests/index.ts"
  },
  "dependencies": {
    "graphql-request": "^7.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^24.13.3",
    "graphql": "^17.0.2",
    "npm-run-all2": "^9.0.3",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "graphql": ">=17 <18"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
